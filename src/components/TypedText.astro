---
interface Props {
	text: string;
	speed?: number;
	delay?: number;
	startEvent?: string;
}

const {
	text,
	speed = 45,
	delay = 400,
	startEvent,
} = Astro.props;
---

<span
	class="typed-text"
	data-text={text}
	data-speed={speed}
	data-delay={delay}
	data-start-event={startEvent}
></span>

<span class="typing-cursor" aria-hidden="true"></span>

<script>
	const typedElements = document.querySelectorAll(".typed-text");

	typedElements.forEach((element) => {
		if (!(element instanceof HTMLElement)) return;

		if (element.dataset.initialized === "true") return;

		const text = element.dataset.text ?? "";
		const speed = Number(element.dataset.speed) || 45;
		const delay = Number(element.dataset.delay) || 400;
		const startEvent = element.dataset.startEvent;

		const cursor = element.nextElementSibling;

		let index = 0;
		let started = false;

		function finishCursor() {
			if (!(cursor instanceof HTMLElement)) return;

			cursor.classList.add("blink");

			setTimeout(() => {
				cursor.classList.remove("blink");
				cursor.style.opacity = "0";
			}, 2400);
		}

		function type() {
			if (index >= text.length) {
				finishCursor();
				return;
			}

			const char = text[index];

			element.textContent += char;
			index++;

			let typingDelay =
				speed * 0.7 + Math.random() * speed * 0.6;

			if (char === "," || char === ";") {
				typingDelay += 150;
			}

			if (
				char === "." ||
				char === "!" ||
				char === "?"
			) {
				typingDelay += 250;
			}

			setTimeout(type, typingDelay);
		}

		function startTyping() {
			if (started) return;

			started = true;
			element.dataset.initialized = "true";

			setTimeout(type, delay);
		}

		if (startEvent) {
			document.addEventListener(
				startEvent,
				startTyping,
				{ once: true },
			);
		} else {
			startTyping();
		}
	});
</script>

<style>
	.typing-cursor {
		display: inline-block;

		width: 0.35em;
		height: 1em;

		margin-left: 3px;

		background: currentColor;

		vertical-align: -0.12em;
		opacity: 1;
	}

	.typing-cursor.blink {
		animation: cursor-blink 0.8s step-end infinite;
	}

	@keyframes cursor-blink {
		50% {
			opacity: 0;
		}
	}
</style>