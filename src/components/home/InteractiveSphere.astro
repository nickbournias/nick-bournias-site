<div class="nb-viz-card">
    <div class="nb-viz-wrap">
        <canvas id="viz"></canvas>
    </div>

    <div class="nb-viz-hint">(click me)</div>
</div>

<script>
    let initialized = false;

    document.addEventListener("init-interactive-sphere", async () => {
        if (initialized) return;

        initialized = true;

        const THREE = await import("three");

        const canvas = document.getElementById("viz");

        if (canvas instanceof HTMLCanvasElement) {
            const scene = new THREE.Scene();

            const camera = new THREE.PerspectiveCamera(70, 1, 0.01, 20);

            camera.position.z = 1.05;

            const renderer = new THREE.WebGLRenderer({
                canvas,
                antialias: true,
                alpha: true,
            });

            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

            function resizeViz() {
                const r = canvas.getBoundingClientRect();

                const w = Math.max(1, Math.floor(r.width));

                const h = Math.max(1, Math.floor(r.height));

                renderer.setSize(w, h, false);

                camera.aspect = w / h;

                camera.updateProjectionMatrix();
            }

            window.addEventListener("resize", resizeViz, {
                passive: true,
            });

            resizeViz();

            const vizMaterial = new THREE.ShaderMaterial({
                transparent: true,

                side: THREE.FrontSide,

                uniforms: {
                    uTime: {
                        value: 0,
                    },

                    uPlay: {
                        value: 0,
                    },

                    uAmp: {
                        value: 0,
                    },

                    uBass: {
                        value: 0,
                    },

                    uMid: {
                        value: 0,
                    },

                    uHigh: {
                        value: 0,
                    },

                    uKick: {
                        value: 0,
                    },

                    uSnare: {
                        value: 0,
                    },
                },

                vertexShader: `
					uniform float uTime;
					uniform float uPlay;
					uniform float uAmp;
					uniform float uBass;
					uniform float uMid;
					uniform float uHigh;
					uniform float uKick;
					uniform float uSnare;

					varying vec3 vPos;

					void main() {
						float t = uTime * 0.8;

						float wave =
							sin(position.x * 4.0 + t) +
							sin(position.y * 5.0 + t * 1.1) +
							sin(position.z * 6.0 + t * 0.9);

						vec3 displaced =
							position * (1.0 + 0.06 * wave);

						float detail =
							sin(
								position.x * 10.0 +
								t * 1.5
							) *
							sin(
								position.y * 9.0 +
								t * 1.2
							) *
							sin(
								position.z * 8.0 +
								t * 1.0
							);

						float distort =
							(0.02 * uPlay) +
							(0.06 * uPlay * uBass);

						displaced +=
							normalize(normal) *
							detail *
							distort;

						float thump =
							(0.10 * uKick) +
							(0.07 * uSnare);

						float kickShape =
							sin(
								t * 8.0 +
								position.y * 5.0
							);

						displaced +=
							normalize(normal) *
							kickShape *
							(0.035 * uKick);

						float snareShape =
							sin(
								position.x * 28.0 +
								t * 14.0
							) *
							sin(
								position.z * 24.0 +
								t * 12.0
							);

						displaced +=
							normalize(normal) *
							snareShape *
							(0.018 * uSnare);

						displaced *=
							(
								1.0 +
								0.02 * uPlay * uAmp +
								0.01 * thump
							);

						vPos = displaced;

						gl_Position =
							projectionMatrix *
							modelViewMatrix *
							vec4(
								displaced,
								1.0
							);
					}
				`,

                fragmentShader: `
					uniform float uTime;
					uniform float uPlay;
					uniform float uAmp;
					uniform float uBass;
					uniform float uMid;
					uniform float uHigh;
					uniform float uKick;
					uniform float uSnare;

					varying vec3 vPos;

					vec3 palette(float t) {
						vec3 a =
							vec3(0.5);

						vec3 b =
							vec3(0.5);

						vec3 c =
							vec3(1.0);

						vec3 d =
							vec3(
								0.00,
								0.33,
								0.67
							);

						return
							a +
							b *
							cos(
								6.28318 *
								(
									c * t +
									d
								)
							);
					}

					void main() {
						if (!gl_FrontFacing) {
							discard;
						}

						vec3 p =
							normalize(vPos);

						float baseT =
							length(vPos) * 1.8 +
							uTime * 0.12;

						float phase =
							baseT +
							uPlay * (0.35 * uMid) +
							uPlay * (0.18 * uHigh) -
							uPlay * (0.10 * uBass);

						phase +=
							0.22 * uKick +
							0.18 * uSnare;

						vec3 col =
							palette(phase);

						float lift =
							1.0 +
							uPlay *
							(
								0.25 * uAmp +
								0.15 * uHigh
							);

						col *= lift;

						col =
							mix(
								col,
								col + 0.12,
								uPlay * 0.35
							);

						col +=
							uKick *
							vec3(
								0.10,
								0.06,
								0.02
							);

						col +=
							uSnare *
							vec3(
								0.04,
								0.06,
								0.10
							);

						float rim =
							1.0 -
							smoothstep(
								0.35,
								1.0,
								abs(p.z)
							);

						col +=
							rim *
							(
								0.06 +
								0.10 * uPlay
							) +
							rim *
							(
								0.08 * uKick +
								0.06 * uSnare
							);

						gl_FragColor =
							vec4(
								col,
								1.0
							);
					}
				`,
            });

            const SPHERE_RADIUS = 0.45;

            const sphereGeo = new THREE.SphereGeometry(SPHERE_RADIUS, 160, 160);

            const sphere = new THREE.Mesh(sphereGeo, vizMaterial);

            scene.add(sphere);

            const GROW_DURATION = 1.25;

            const GROW_START_SCALE = 0.02;

            let growStart = performance.now() * 0.001;

            sphere.scale.setScalar(GROW_START_SCALE);

            function smoothstep01(x: number) {
                x = Math.min(Math.max(x, 0), 1);

                return x * x * (3.0 - 2.0 * x);
            }

            const raycaster = new THREE.Raycaster();

            const mouse = new THREE.Vector2();

            let vizState = "idle";

            let bubbles: THREE.Mesh[] = [];

            let explodeStart = 0;

            const BUBBLE_COUNT = 90;

            const BUBBLE_RADIUS = 0.045;

            const EXPLODE_DURATION = 1.0;

            const HOLD_DURATION = 0.6;

            const RETURN_DURATION = 1.2;

            const OUTWARD_IMPULSE_MIN = 0.02;

            const OUTWARD_IMPULSE_MAX = 0.035;

            const DRAG_EXPLODE = 0.985;

            const DRAG_RETURN = 0.9;

            const BOUNCE_RADIUS = 1.1;

            function resetToSphere() {
                for (const bubble of bubbles) {
                    scene.remove(bubble);

                    bubble.geometry.dispose();

                    if (Array.isArray(bubble.material)) {
                        bubble.material.forEach((material) =>
                            material.dispose(),
                        );
                    } else {
                        bubble.material.dispose();
                    }
                }

                bubbles = [];

                sphere.visible = true;

                vizState = "idle";
            }

            function makeBubbles() {
                bubbles = [];

                for (let i = 0; i < BUBBLE_COUNT; i++) {
                    const bubbleGeo = new THREE.SphereGeometry(
                        BUBBLE_RADIUS,
                        24,
                        24,
                    );

                    const bubbleMaterial = vizMaterial.clone();

                    bubbleMaterial.uniforms = {
                        uTime: {
                            value: 0,
                        },

                        uPlay: {
                            value: 0,
                        },

                        uAmp: {
                            value: 0,
                        },

                        uBass: {
                            value: 0,
                        },

                        uMid: {
                            value: 0,
                        },

                        uHigh: {
                            value: 0,
                        },

                        uKick: {
                            value: 0,
                        },

                        uSnare: {
                            value: 0,
                        },
                    };

                    const bubble = new THREE.Mesh(bubbleGeo, bubbleMaterial);

                    const dir = new THREE.Vector3(
                        Math.random() * 2 - 1,
                        Math.random() * 2 - 1,
                        Math.random() * 2 - 1,
                    );

                    if (dir.lengthSq() < 1e-6) {
                        dir.set(1, 0, 0);
                    }

                    dir.normalize();

                    const home = dir
                        .clone()
                        .multiplyScalar(
                            SPHERE_RADIUS * (0.95 + Math.random() * 0.1),
                        );

                    bubble.position.copy(home);

                    const impulse =
                        OUTWARD_IMPULSE_MIN +
                        Math.random() *
                            (OUTWARD_IMPULSE_MAX - OUTWARD_IMPULSE_MIN);

                    bubble.userData.vel = dir.clone().multiplyScalar(impulse);

                    bubble.userData.home = home;

                    scene.add(bubble);

                    bubbles.push(bubble);
                }
            }

            function explodeAndReturn() {
                if (vizState !== "idle") {
                    return;
                }

                explodeStart = performance.now() * 0.001;

                vizState = "explode";

                sphere.visible = false;

                makeBubbles();
            }

            canvas.addEventListener(
                "pointerdown",
                (event) => {
                    if (vizState !== "idle") {
                        return;
                    }

                    const r = canvas.getBoundingClientRect();

                    mouse.x = ((event.clientX - r.left) / r.width) * 2 - 1;

                    mouse.y = -(((event.clientY - r.top) / r.height) * 2 - 1);

                    raycaster.setFromCamera(mouse, camera);

                    const hit = raycaster.intersectObject(sphere, false);

                    if (hit.length) {
                        explodeAndReturn();
                    }
                },
                {
                    passive: true,
                },
            );

            const tmp = new THREE.Vector3();

            const tmp2 = new THREE.Vector3();

            function pushUniforms(mat: THREE.ShaderMaterial) {
                mat.uniforms.uTime.value = vizMaterial.uniforms.uTime.value;

                mat.uniforms.uPlay.value = 0;
                mat.uniforms.uAmp.value = 0;
                mat.uniforms.uBass.value = 0;
                mat.uniforms.uMid.value = 0;
                mat.uniforms.uHigh.value = 0;
                mat.uniforms.uKick.value = 0;
                mat.uniforms.uSnare.value = 0;
            }

            function animateViz(ms: number) {
                const t = ms * 0.001;

                vizMaterial.uniforms.uTime.value = t;

                if (sphere.visible) {
                    const g = (t - growStart) / GROW_DURATION;

                    const eased = smoothstep01(g);

                    const scale = THREE.MathUtils.lerp(
                        GROW_START_SCALE,
                        1.0,
                        eased,
                    );

                    sphere.scale.setScalar(scale);
                }

                if (vizState === "idle") {
                    sphere.rotation.y = t * 0.35;

                    sphere.rotation.x = t * 0.18;
                }

                if (vizState === "explode" || vizState === "return") {
                    const elapsed = t - explodeStart;

                    if (
                        vizState === "explode" &&
                        elapsed > EXPLODE_DURATION + HOLD_DURATION
                    ) {
                        vizState = "return";
                    }

                    if (
                        vizState === "return" &&
                        elapsed >
                            EXPLODE_DURATION + HOLD_DURATION + RETURN_DURATION
                    ) {
                        resetToSphere();
                    }

                    for (const bubble of bubbles) {
                        const material = bubble.material;

                        if (material instanceof THREE.ShaderMaterial) {
                            pushUniforms(material);
                        }

                        const vel = bubble.userData.vel as THREE.Vector3;

                        if (vizState === "explode") {
                            vel.multiplyScalar(DRAG_EXPLODE);

                            vel.x += (Math.random() - 0.5) * 0.00045;

                            vel.y += (Math.random() - 0.5) * 0.00045;

                            vel.z += (Math.random() - 0.5) * 0.00045;

                            bubble.position.add(vel);

                            const d = bubble.position.length();

                            if (d > BOUNCE_RADIUS) {
                                const n = tmp
                                    .copy(bubble.position)
                                    .multiplyScalar(1 / d);

                                const vn = vel.dot(n);

                                tmp2.copy(n).multiplyScalar(2 * vn);

                                vel.sub(tmp2);

                                bubble.position.copy(
                                    n.multiplyScalar(BOUNCE_RADIUS),
                                );

                                vel.multiplyScalar(0.85);
                            }
                        } else {
                            vel.multiplyScalar(DRAG_RETURN);

                            tmp.copy(bubble.userData.home as THREE.Vector3).sub(
                                bubble.position,
                            );

                            vel.add(tmp.multiplyScalar(0.06));

                            bubble.position.add(vel);
                        }
                    }
                }

                renderer.render(scene, camera);

                requestAnimationFrame(animateViz);
            }

            requestAnimationFrame(animateViz);
        }
    });
</script>

<style>
    .nb-viz-card {
        width: 100%;
        max-width: 320px;
        margin: 0 auto;
        text-align: center;
    }

    .nb-viz-wrap {
        width: 100%;
        aspect-ratio: 1 / 1;
        position: relative;
        border-radius: 16px;
        overflow: hidden;
    }

    #viz {
        width: 100%;
        height: 100%;
        display: block;
    }

    .nb-viz-hint {
        margin-top: 10px;
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.65;
        user-select: none;
    }

    @media (max-width: 767px) {
        .nb-viz-card {
            max-width: 250px;
        }
    }
</style>
