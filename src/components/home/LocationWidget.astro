<div class="location-widget" data-location-widget>
	<div
		class="location-selector"
		aria-label="Location selector"
	>
		<button
			class="location-option active"
			type="button"
			data-location="denver"
		>
			Denver
		</button>

		<button
			class="location-option"
			type="button"
			data-location="nyc"
		>
			NYC
		</button>

		<button
			class="location-option"
			type="button"
			data-location="la"
		>
			LA
		</button>

		<button
			class="location-option visitor-location"
			type="button"
			data-location="you"
			hidden
		>
			You
		</button>
	</div>

	<div class="location-heading">
		<span class="location-dot"></span>

		<span class="location-name">
			Denver, CO
		</span>

		<span
			class="day-night-icon"
			role="img"
			aria-label="Nighttime"
		>
			<span
				class="sun-icon"
				aria-hidden="true"
				hidden
			>
				☀
			</span>

			<canvas
                class="moon-phase-canvas"
                width="256"
                height="256"
                aria-hidden="true"
                hidden
            ></canvas>

			<span
				class="moon-fallback"
				aria-hidden="true"
			>
				☾
			</span>
		</span>
	</div>

	<div class="location-time">
		--:--
	</div>

	<div class="location-weather">
		<span class="temperature">
			--
		</span>

		<span class="weather-condition">
			Loading
		</span>
	</div>

	<div class="location-timezone">
		Mountain Time
	</div>
</div>

<script>
	type LocationData = {
		city: string;
		timeZone: string;
		label: string;
		latitude: number;
		longitude: number;
	};

	const root = document.querySelector(
		"[data-location-widget]",
	);

	if (root instanceof HTMLElement) {
		const locations: Record<string, LocationData> = {
			denver: {
				city: "Denver, CO",
				timeZone: "America/Denver",
				label: "Mountain Time",
				latitude: 39.7392,
				longitude: -104.9903,
			},

			bethesda: {
				city: "Bethesda, MD",
				timeZone: "America/New_York",
				label: "Eastern Time",
				latitude: 38.9847,
				longitude: -77.0947,
			},

			nyc: {
				city: "New York, NY",
				timeZone: "America/New_York",
				label: "Eastern Time",
				latitude: 40.7128,
				longitude: -74.006,
			},

			la: {
				city: "Los Angeles, CA",
				timeZone: "America/Los_Angeles",
				label: "Pacific Time",
				latitude: 34.0522,
				longitude: -118.2437,
			},
		};

		const timeElement =
			root.querySelector(".location-time");

		const locationName =
			root.querySelector(".location-name");

		const timezoneElement =
			root.querySelector(".location-timezone");

		const locationButtons =
			root.querySelectorAll<HTMLButtonElement>(
				".location-option",
			);

		const visitorButton =
			root.querySelector<HTMLButtonElement>(
				".visitor-location",
			);

		const temperatureElement =
			root.querySelector(".temperature");

		const conditionElement =
			root.querySelector(".weather-condition");

		const dayNightElement =
			root.querySelector(".day-night-icon");

		const sunIcon =
			root.querySelector<HTMLElement>(".sun-icon");

		const moonCanvas =
			root.querySelector<HTMLCanvasElement>(
				".moon-phase-canvas",
			);

		const moonFallback =
			root.querySelector<HTMLElement>(
				".moon-fallback",
			);

		let selectedLocation = "denver";

		const SYNODIC_MONTH = 29.530588853;

		const NEW_MOON_EPOCH =
			Date.UTC(2000, 0, 6, 18, 14);

		const MILLISECONDS_PER_DAY =
			24 * 60 * 60 * 1000;

		function getTimezoneLabel(timeZone: string) {
			const formatter = new Intl.DateTimeFormat(
				"en-US",
				{
					timeZone,
					timeZoneName: "long",
				},
			);

			const parts =
				formatter.formatToParts(new Date());

			return (
				parts.find(
					(part) =>
						part.type === "timeZoneName",
				)?.value ?? timeZone
			);
		}

		function updateTime() {
			const location =
				locations[selectedLocation];

			if (!location || !timeElement) return;

			const formatter =
				new Intl.DateTimeFormat("en-US", {
					timeZone: location.timeZone,
					hour: "numeric",
					minute: "2-digit",
					hour12: true,
				});

			timeElement.textContent =
				formatter.format(new Date());
		}

		function getWeatherCondition(code: number) {
			if (code === 0) {
				return "Clear";
			}

			if (
				[1, 2, 3, 45, 48].includes(code)
			) {
				return "Cloudy";
			}

			if (
				[
					51, 53, 55, 56, 57,
					61, 63, 65, 66, 67,
					80, 81, 82,
				].includes(code)
			) {
				return "Rain";
			}

			if (
				[71, 73, 75, 77, 85, 86].includes(
					code,
				)
			) {
				return "Snow";
			}

			if ([95, 96, 99].includes(code)) {
				return "Storm";
			}

			return "Unknown";
		}

		function renderWeatherLoading() {
			if (temperatureElement) {
				temperatureElement.textContent = "--";
			}

			if (conditionElement) {
				conditionElement.textContent =
					"Loading";
			}
		}

		function renderWeatherError() {
			if (temperatureElement) {
				temperatureElement.textContent = "--";
			}

			if (conditionElement) {
				conditionElement.textContent =
					"Unavailable";
			}
		}

		function renderWeather(
			temperature: number,
			weatherCode: number,
		) {
			if (temperatureElement) {
				temperatureElement.textContent =
					`${Math.round(temperature)}°F`;
			}

			if (conditionElement) {
				conditionElement.textContent =
					getWeatherCondition(weatherCode);
			}
		}

		function getMoonPhaseName(phase: number) {
			if (
				phase < 0.0625 ||
				phase >= 0.9375
			) {
				return "New Moon";
			}

			if (phase < 0.1875) {
				return "Waxing Crescent";
			}

			if (phase < 0.3125) {
				return "First Quarter";
			}

			if (phase < 0.4375) {
				return "Waxing Gibbous";
			}

			if (phase < 0.5625) {
				return "Full Moon";
			}

			if (phase < 0.6875) {
				return "Waning Gibbous";
			}

			if (phase < 0.8125) {
				return "Last Quarter";
			}

			return "Waning Crescent";
		}

		function getMoonPhase(date = new Date()) {
			const daysSinceEpoch =
				(date.getTime() -
					NEW_MOON_EPOCH) /
				MILLISECONDS_PER_DAY;

			const cyclePosition =
				(((daysSinceEpoch /
					SYNODIC_MONTH) %
					1) +
					1) %
				1;

			const illumination =
				(1 -
					Math.cos(
						2 *
							Math.PI *
							cyclePosition,
					)) /
				2;

			return {
				phase: cyclePosition,
				illumination,
				name: getMoonPhaseName(
					cyclePosition,
				),
			};
		}

		function renderMoonPhase(
			location: LocationData,
		) {
			if (!moonCanvas) {
				return false;
			}

			const context =
				moonCanvas.getContext("2d");

			if (!context) {
				return false;
			}

			const {
				phase,
				illumination,
				name,
			} = getMoonPhase();

			const width = moonCanvas.width;
			const height = moonCanvas.height;

			const centerX = width / 2;
			const centerY = height / 2;

			const radius =
				Math.min(width, height) / 2 - 2;

			const image =
				context.createImageData(
					width,
					height,
				);

			const pixels = image.data;

			const phaseAngle =
				phase * Math.PI * 2;

			const hemisphere =
				location.latitude < 0 ? -1 : 1;

			const sunX =
				Math.sin(phaseAngle) *
				hemisphere;

			const sunZ =
				-Math.cos(phaseAngle);

			for (
				let pixelY = 0;
				pixelY < height;
				pixelY++
			) {
				for (
					let pixelX = 0;
					pixelX < width;
					pixelX++
				) {
					const x =
						(pixelX +
							0.5 -
							centerX) /
						radius;

					const y =
						(pixelY +
							0.5 -
							centerY) /
						radius;

					const distanceSquared =
						x * x + y * y;

					if (
						distanceSquared > 1
					) {
						continue;
					}

					const z = Math.sqrt(
						1 -
							distanceSquared,
					);

					const lightAmount =
						x * sunX +
						z * sunZ;

					const illuminated =
						lightAmount > 0;

					const limbBrightness =
						0.72 + z * 0.28;

					const brightness =
						illuminated
							? Math.round(
									235 *
										limbBrightness,
								)
							: Math.round(
									20 *
										limbBrightness,
								);

					const index =
						(pixelY * width +
							pixelX) *
						4;

					pixels[index] =
						brightness;

					pixels[index + 1] =
						brightness;

					pixels[index + 2] =
						brightness;

					pixels[index + 3] =
						255;
				}
			}

			context.clearRect(
				0,
				0,
				width,
				height,
			);

			context.putImageData(
				image,
				0,
				0,
			);

			const percentage =
				Math.round(
					illumination * 100,
				);

			if (dayNightElement) {
				dayNightElement.setAttribute(
					"aria-label",
					`${name}, ${percentage}% illuminated`,
				);

				dayNightElement.setAttribute(
					"title",
					`${name} · ${percentage}% illuminated`,
				);
			}

			return true;
		}

		function renderDayNight(
			isDay: boolean,
			location: LocationData,
		) {
			if (isDay) {
				if (sunIcon) {
					sunIcon.hidden = false;
				}

				if (moonCanvas) {
					moonCanvas.hidden = true;
				}

				if (moonFallback) {
					moonFallback.hidden = true;
				}

				if (dayNightElement) {
					dayNightElement.setAttribute(
						"aria-label",
						"Daytime",
					);

					dayNightElement.removeAttribute(
						"title",
					);
				}

				return;
			}

			if (sunIcon) {
				sunIcon.hidden = true;
			}

			try {
				const rendered =
					renderMoonPhase(location);

				if (!rendered) {
					throw new Error(
						"Moon canvas unavailable",
					);
				}

				if (moonCanvas) {
					moonCanvas.hidden = false;
				}

				if (moonFallback) {
					moonFallback.hidden = true;
				}
			} catch (error) {
				console.warn(
					"Moon phase rendering unavailable.",
					error,
				);

				if (moonCanvas) {
					moonCanvas.hidden = true;
				}

				if (moonFallback) {
					moonFallback.hidden = false;
				}

				if (dayNightElement) {
					dayNightElement.setAttribute(
						"aria-label",
						"Nighttime",
					);
				}
			}
		}

		function getFallbackDayState(
			location: LocationData,
		) {
			try {
				const formatter =
					new Intl.DateTimeFormat(
						"en-US",
						{
							timeZone:
								location.timeZone,
							hour: "numeric",
							hourCycle: "h23",
						},
					);

				const parts =
					formatter.formatToParts(
						new Date(),
					);

				const hour = Number(
					parts.find(
						(part) =>
							part.type ===
							"hour",
					)?.value,
				);

				return (
					hour >= 6 &&
					hour < 18
				);
			} catch {
				return false;
			}
		}

		async function fetchWeather(
			location: LocationData,
		) {
			renderWeatherLoading();

			try {
				const params =
					new URLSearchParams({
						latitude:
							location.latitude.toString(),
						longitude:
							location.longitude.toString(),
						current:
							"temperature_2m,weather_code,is_day",
						temperature_unit:
							"fahrenheit",
					});

				const response = await fetch(
					`https://api.open-meteo.com/v1/forecast?${params}`,
				);

				if (!response.ok) {
					throw new Error(
						"Weather request failed",
					);
				}

				const data =
					await response.json();

				const temperature =
					data.current
						?.temperature_2m;

				const weatherCode =
					data.current
						?.weather_code;

				const isDay =
					data.current?.is_day;

				if (
					typeof temperature !==
						"number" ||
					typeof weatherCode !==
						"number"
				) {
					throw new Error(
						"Incomplete weather data",
					);
				}

				renderWeather(
					temperature,
					weatherCode,
				);

				if (
					isDay === 0 ||
					isDay === 1
				) {
					renderDayNight(
						isDay === 1,
						location,
					);
				} else {
					renderDayNight(
						getFallbackDayState(
							location,
						),
						location,
					);
				}
			} catch (error) {
				console.warn(
					"Weather unavailable.",
					error,
				);

				renderWeatherError();

				renderDayNight(
					getFallbackDayState(
						location,
					),
					location,
				);
			}
		}

		function selectLocation(
			locationKey: string,
		) {
			const location =
				locations[locationKey];

			if (!location) return;

			selectedLocation =
				locationKey;

			if (locationName) {
				locationName.textContent =
					location.city;
			}

			if (timezoneElement) {
				timezoneElement.textContent =
					location.label;
			}

			locationButtons.forEach(
				(button) => {
					button.classList.toggle(
						"active",
						button.dataset
							.location ===
							selectedLocation,
					);
				},
			);

			updateTime();

			renderDayNight(
				getFallbackDayState(
					location,
				),
				location,
			);

			fetchWeather(location);
		}

		async function detectVisitorLocation() {
			try {
				const response =
					await fetch(
						"https://ipapi.co/json/",
					);

				if (!response.ok) {
					throw new Error(
						"Location lookup failed",
					);
				}

				const data =
					await response.json();

				if (
					!data.city ||
					!data.timezone ||
					typeof data.latitude !==
						"number" ||
					typeof data.longitude !==
						"number"
				) {
					throw new Error(
						"Incomplete location data",
					);
				}

				const region =
					data.region_code
						? `, ${data.region_code}`
						: "";

				locations.you = {
					city:
						`${data.city}${region}`,
					timeZone:
						data.timezone,
					label:
						getTimezoneLabel(
							data.timezone,
						),
					latitude:
						data.latitude,
					longitude:
						data.longitude,
				};

				if (visitorButton) {
					visitorButton.hidden =
						false;
				}
			} catch (error) {
				console.warn(
					"Visitor location unavailable.",
					error,
				);

				if (visitorButton) {
					visitorButton.hidden =
						true;
				}
			}
		}

		locationButtons.forEach(
			(button) => {
				button.addEventListener(
					"click",
					() => {
						const locationKey =
							button.dataset
								.location;

						if (
							locationKey &&
							locationKey in
								locations
						) {
							selectLocation(
								locationKey,
							);
						}
					},
				);
			},
		);

		updateTime();

		renderDayNight(
			getFallbackDayState(
				locations[
					selectedLocation
				],
			),
			locations[selectedLocation],
		);

		fetchWeather(
			locations[selectedLocation],
		);

		setInterval(
			updateTime,
			1000,
		);

		setInterval(() => {
			const location =
				locations[selectedLocation];

			if (location) {
				fetchWeather(location);
			}
		}, 10 * 60 * 1000);

		detectVisitorLocation();
	}
</script>

<style>
	.location-widget {
		position: relative;

		width: min(100%, 350px);
		margin-inline: auto;
		padding: 1.2rem 1.6rem;

		overflow: hidden;

		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 20px;

		background: linear-gradient(
			145deg,
			rgba(255, 255, 255, 0.055),
			rgba(255, 255, 255, 0.015)
		);

		box-shadow: none;
	}

	.location-widget::before {
		content: "";
		position: absolute;

		top: -90px;
		right: -70px;

		width: 180px;
		height: 180px;

		border-radius: 50%;

		background: rgba(255, 255, 255, 0.04);

		filter: blur(10px);

		pointer-events: none;
	}

	.location-selector {
		position: relative;
		z-index: 1;

		display: inline-flex;
		align-items: center;
		gap: 0.2rem;

		padding: 0.25rem;
		margin-bottom: 1.2rem;

		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 999px;

		background: rgba(255, 255, 255, 0.025);
	}

	.location-option {
		border: none;
		border-radius: 999px;

		padding: 0.42rem 0.7rem;

		background: transparent;

		color: rgba(255, 255, 255, 0.38);

		font-family: inherit;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.02em;

		cursor: pointer;
	}

	.location-option.active {
		background: rgba(255, 255, 255, 0.09);

		color: rgba(255, 255, 255, 0.92);

		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.06),
			0 2px 8px rgba(0, 0, 0, 0.12);
	}

	.location-heading {
		position: relative;
		z-index: 1;

		display: flex;
		align-items: center;
		gap: 0.6rem;

		margin-bottom: 0.35rem;
		padding-right: 3.5rem;

		color: rgba(255, 255, 255, 0.68);

		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.location-dot {
		width: 6px;
		height: 6px;

		flex-shrink: 0;

		border-radius: 50%;

		background: #9dd8b8;

		box-shadow:
			0 0 0 4px rgba(157, 216, 184, 0.08);
	}

	.day-night-icon {
		position: absolute;
		right: 0;
		top: 50%;

		display: inline-flex;
		align-items: center;
		justify-content: center;

		width: 3rem;
		height: 3rem;

		margin: 0;
		transform: translateY(-50%);

		flex-shrink: 0;
	}

	.sun-icon {
		color: rgba(255, 255, 255, 0.75);

		font-size: 3rem;
		line-height: 1;
	}

	.moon-phase-canvas {
		display: block;

		width: 3rem;
		height: 3rem;

		margin-right: 0.35rem;

		border-radius: 50%;
	}

	.moon-fallback {
		color: rgba(255, 255, 255, 0.75);

		font-size: 1.15rem;
		line-height: 1;
	}

	.sun-icon[hidden],
	.moon-phase-canvas[hidden],
	.moon-fallback[hidden] {
		display: none;
	}

	.location-time {
		position: relative;
		z-index: 1;

		margin-bottom: 0.85rem;

		color: rgba(255, 255, 255, 0.96);

		font-size: clamp(2.6rem, 10vw, 3.45rem);
		font-weight: 400;

		line-height: 0.95;
		letter-spacing: -0.055em;

		font-variant-numeric: tabular-nums;
	}

	.location-weather {
		position: relative;
		z-index: 1;

		display: flex;
		align-items: baseline;
		gap: 0.7rem;

		margin-bottom: 0.3rem;
	}

	.temperature {
		color: rgba(255, 255, 255, 0.88);

		font-size: 1.05rem;
		font-weight: 500;
	}

	.weather-condition {
		color: rgba(255, 255, 255, 0.42);

		font-size: 0.8rem;
		font-weight: 400;
	}

	.location-timezone {
		position: relative;
		z-index: 1;

		color: rgba(255, 255, 255, 0.3);

		font-size: 0.72rem;
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	@media (max-width: 767px) {
		.location-widget {
			width: 80%;
			max-width: 340px;
			margin-inline: auto;
			padding: 0.8rem 1.25rem;
			border-radius: 16px;
		}

		.location-selector {
			margin-bottom: 0.65rem;
		}

		.location-heading {
			position: relative;
			margin-bottom: 0.1rem;
			padding-right: 4.25rem;
		}

		.day-night-icon {
			position: absolute;
			right: 0;
			top: 50%;

			width: 3.75rem;
			height: 3.75rem;

			margin: 0;
			transform: translateY(-50%);
		}

		.moon-phase-canvas {
			width: 3.75rem;
			height: 3.75rem;
			margin: 0;
		}

		.sun-icon {
			font-size: 3.75rem;
		}

		.location-time {
			font-size: 2.4rem;
			margin-bottom: 0.4rem;
