<header class="site-header">
	<div class="navbar container">
		<a class="brand" href="/">Nick Bournias</a>

		<button
			class="menu-toggle"
			type="button"
			aria-label="Toggle navigation"
			aria-expanded="false"
			aria-controls="mobile-navigation"
		>
			<span></span>
			<span></span>
		</button>

		<nav
			id="mobile-navigation"
			class="nav-links"
			aria-label="Main navigation"
		>
			<a href="/portfolio">Portfolio</a>
			<a href="/writings">Writings</a>
			<a href="/apps">Apps</a>
			<a href="/about-me">About</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector(".menu-toggle");
	const nav = document.querySelector(".nav-links");

	if (
		toggle instanceof HTMLButtonElement &&
		nav instanceof HTMLElement
	) {
		const closeMenu = () => {
			nav.classList.remove("is-open");
			toggle.classList.remove("is-open");
			toggle.setAttribute("aria-expanded", "false");
			document.body.classList.remove("menu-open");
		};

		toggle.addEventListener("click", () => {
			const isOpen = nav.classList.toggle("is-open");

			toggle.classList.toggle("is-open", isOpen);
			toggle.setAttribute("aria-expanded", String(isOpen));
			document.body.classList.toggle("menu-open", isOpen);
		});

		nav.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", closeMenu);
		});

		window.addEventListener("resize", () => {
			if (window.innerWidth >= 768) {
				closeMenu();
			}
		});
	}
</script>

<style>
	.site-header {
		position: relative;
		z-index: 1000;

		width: 100%;
		padding-top: 24px;
	}

	.navbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;

		min-height: 64px;
	}

	.brand {
		position: relative;
		z-index: 1002;

		font-size: 1.25rem;
		font-weight: 800;
		white-space: nowrap;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 32px;
	}

	.nav-links a {
		color: #cbcbcb;

		font-size: 1.25rem;
		font-weight: 200;
		white-space: nowrap;

		text-decoration: none;

		transition: color 0.2s ease;
	}

	.nav-links a:hover {
		color: #fffdfd;
	}

	.menu-toggle {
		display: none;
	}

	@media (max-width: 767px) {
		.site-header {
			padding-top: 18px;
		}

		.navbar {
			min-height: 56px;
		}

		.brand {
			font-size: 1rem;
		}

		/* MENU BUTTON */

		.menu-toggle {
			position: relative;
			z-index: 1002;

			display: block;

			width: 32px;
			height: 32px;
			padding: 0;

			border: 0;
			background: transparent;

			cursor: pointer;
		}

		.menu-toggle span {
			position: absolute;
			left: 5px;

			width: 22px;
			height: 1px;

			background: #cbcbcb;

			transition:
				top 0.3s cubic-bezier(0.22, 1, 0.36, 1),
				transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.menu-toggle span:first-child {
			top: 11px;
		}

		.menu-toggle span:last-child {
			top: 20px;
		}

		.menu-toggle.is-open span:first-child {
			top: 16px;
			transform: rotate(45deg);
		}

		.menu-toggle.is-open span:last-child {
			top: 16px;
			transform: rotate(-45deg);
		}

		/* FULL SCREEN MENU */

		.nav-links {
			position: fixed;
			inset: 0;
			z-index: 1001;

			display: flex;
			flex-direction: column;
			align-items: flex-end;
            text-align: right;
			justify-content: center;
			gap: 0.6rem;

			padding-inline: max(1.5rem, calc((100vw - 1200px) / 2));

			background: rgba(27, 27, 27, 0.98);

			backdrop-filter: blur(18px);
			-webkit-backdrop-filter: blur(18px);

			opacity: 0;
			visibility: hidden;
			pointer-events: none;

			transform: translateY(-10px);

			transition:
				opacity 0.3s ease,
				transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
				visibility 0.3s ease;
		}

		.nav-links.is-open {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;

			transform: translateY(0);
		}

		.nav-links a {
			color: rgba(255, 255, 255, 0.72);

			font-size: clamp(2.2rem, 10vw, 3.6rem);
			font-weight: 300;
			line-height: 1.15;
			letter-spacing: -0.03em;
            text-align: right;

			opacity: 0;

			transform: translateY(14px);

			transition:
				color 0.2s ease,
				opacity 0.35s ease,
				transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.nav-links.is-open a {
			opacity: 1;
			transform: translateY(0);
		}

		.nav-links.is-open a:nth-child(1) {
			transition-delay: 0.05s;
		}

		.nav-links.is-open a:nth-child(2) {
			transition-delay: 0.1s;
		}

		.nav-links.is-open a:nth-child(3) {
			transition-delay: 0.15s;
		}

		.nav-links.is-open a:nth-child(4) {
			transition-delay: 0.2s;
		}

		.nav-links a:hover {
			color: #fff;
		}
	}

	:global(body.menu-open) {
		overflow: hidden;
	}
</style>