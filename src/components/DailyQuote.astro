---
import dailyQuote from "../../public/daily-quote.json";
import TypedText from "./TypedText.astro";

const quoteText = `"${dailyQuote.quote}" — ${dailyQuote.author}`;

const authorSearchUrl =
	`https://www.google.com/search?q=${encodeURIComponent(dailyQuote.author)}`;
---

<div class="daily-quote">
	<p class="quote-label">Quote of the day</p>

	<p class="quote-text">
		<TypedText
			text={quoteText}
			speed={32}
			delay={500}
            startEvent="init-daily-quote"
		/>
	</p>

	<a
		class="learn-more"
		href={authorSearchUrl}
		target="_blank"
		rel="noopener noreferrer"
	>
		Learn more
	</a>
</div>

<style>
	.daily-quote {
		width: 100%;
		max-width: 800px;
		text-align: left;
	}

	.quote-label {
		margin: 0 0 1rem;

		color: rgba(255, 255, 255, 0.35);

		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.quote-text {
		margin: 0;

		color: var(--muted);

		font-size: clamp(1.4rem, 2.5vw, 1.6rem);
		line-height: 1.5;
	}

	.learn-more {
        display: block;
        width: 100%;
        margin-top: 0.75rem;

        color: rgba(255, 255, 255, 0.4);

        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.06em;

        text-align: right;
        text-decoration: underline;
        text-underline-offset: 3px;

        transition: color 0.2s ease;
    }

    .learn-more:hover {
        color: rgba(255, 255, 255, 0.85);
    }
</style>
