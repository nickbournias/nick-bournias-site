---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import TypedText from "../components/TypedText.astro";

const writings = (await getCollection("writings")).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const formatDate = (date: Date | string) =>
    new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
    }).format(new Date(date));
---

<BaseLayout
    title="Writings - Nick Bournias"
    description="Personal writings of Nick Bournias"
>
    <section class="writings-section">
        <div class="container">
            <header class="writings-header">
                <p class="eyebrow">Writings</p>

                <h1>Things worth thinking about.</h1>

                <p class="intro">
                    <TypedText text="A collection of thoughts on technology, AI, development, work, and whatever else I find interesting." />
                </p>
            </header>

            <div class="divider"></div>

            <div class="writing-list">
                {
                    writings.map((writing) => (
                        <article class="writing-entry">
                            <div class="writing-meta">
                                <time
                                    datetime={new Date(
                                        writing.data.date,
                                    ).toISOString()}
                                >
                                    {formatDate(writing.data.date)}
                                </time>

                                {writing.data.category && (
                                    <span>{writing.data.category}</span>
                                )}
                            </div>

                            <a
                                class="writing-link"
                                href={`/writings/${writing.id}/`}
                            >
                                <h2>{writing.data.title}</h2>

                                <p>{writing.data.description}</p>

                                <span class="read-link">Read essay</span>
                            </a>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .writings-section {
        padding: 5rem 0;
    }

    .container {
        width: min(100% - 2rem, 1200px);
        margin-inline: auto;
    }

    .writings-header {
        max-width: 760px;
    }

    .eyebrow {
        margin: 0 0 1rem;

        color: rgba(255, 255, 255, 0.42);

        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;

        max-width: 700px;

        font-size: clamp(2.4rem, 6vw, 4.4rem);
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: -0.035em;
    }

    .intro {
        margin: 1.6rem 0 0;

        max-width: 620px;

        color: var(--muted);

        font-size: clamp(1rem, 2vw, 1.2rem);
        line-height: 1.65;
    }

    .divider {
        width: 100%;
        height: 1px;

        margin-top: 4rem;

        background: rgba(255, 255, 255, 0.12);
    }

    .writing-list {
        margin-top: 1rem;
    }

    .writing-entry {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 3rem;

        padding: 3rem 0;

        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .writing-meta {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;

        padding-top: 0.4rem;

        color: rgba(255, 255, 255, 0.3);

        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .writing-link {
        display: block;

        max-width: 820px;

        color: inherit;
        text-decoration: none;
    }

    .writing-link h2 {
        margin: 0;

        max-width: 760px;

        color: rgba(255, 255, 255, 0.96);

        font-size: clamp(1.9rem, 3vw, 2.7rem);
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.035em;

        transition:
            transform 0.25s ease,
            color 0.25s ease;
    }

    .writing-link p {
        margin: 1rem 0 0;

        max-width: 700px;

        color: rgba(255, 255, 255, 0.46);

        font-size: 1rem;
        line-height: 1.7;
    }

    .read-link {
        display: inline-block;

        margin-top: 1.35rem;
        padding-bottom: 0.2rem;

        color: rgba(255, 255, 255, 0.58);

        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.04em;

        border-bottom: 1px solid rgba(255, 255, 255, 0.18);

        transition:
            color 0.25s ease,
            border-color 0.25s ease;
    }

    .writing-entry:hover .writing-link h2 {
        transform: translateX(4px);

        color: #ffffff;
    }

    .writing-entry:hover .read-link {
        color: rgba(255, 255, 255, 0.9);

        border-color: rgba(255, 255, 255, 0.5);
    }

    .typing-cursor {
        display: inline-block;
        width: 0.35em;
        height: 1em;
        margin-left: 3px;

        background: currentColor;

        vertical-align: -0.12em;
        opacity: 1;
    }

    .typing-cursor.blink {
        animation: cursor-blink 0.8s step-end infinite;
    }

    h1 {
		margin: 0;

		font-size: clamp(2.8rem, 8vw, 5rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

    @keyframes cursor-blink {
        50% {
            opacity: 0;
        }
    }

    @media (max-width: 767px) {
        .writings-section {
            padding: 3.5rem 0;
        }

        .intro {
            margin-top: 1.25rem;
        }

        .divider {
            margin-top: 3rem;
        }

        .writing-entry {
            grid-template-columns: 1fr;
            gap: 1rem;

            padding: 2.25rem 0;
        }

        .writing-meta {
            padding-top: 0;
        }

        .writing-link h2 {
            font-size: 1.7rem;
        }

        .writing-link p {
            font-size: 0.95rem;
        }

        .read-link {
            margin-top: 1.1rem;
        }
    }
</style>
