---
import BaseLayout from "../layouts/BaseLayout.astro";
import DailyQuote from "../components/DailyQuote.astro";
---

<BaseLayout
	title="Nick Bournias"
	,
	description="Personal website of Nick Bournias"
>
	<section class="about-section">
		<div class="container">
			<div class="about-grid">
				<div class="about-extra">
					<div class="location-widget">
						<div
							class="location-selector"
							aria-label="Location selector"
						>
							<button
								class="location-option active"
								type="button"
								data-location="denver"
							>
								Denver
							</button>

							<button
								class="location-option"
								type="button"
								data-location="nyc"
							>
								NYC
							</button>

							<button
								class="location-option"
								type="button"
								data-location="la"
							>
								LA
							</button>

							<button
								class="location-option visitor-location"
								type="button"
								data-location="you"
								hidden
							>
								You
							</button>
						</div>

						<div class="location-heading">
							<span class="location-dot"></span>

							<span class="location-name"> Denver, CO </span>

							<span
								class="day-night-icon"
								role="img"
								aria-label="Nighttime"
							>
								<span
									class="sun-icon"
									aria-hidden="true"
									hidden
								>
									☀
								</span>

								<canvas
									class="moon-phase-canvas"
									width="96"
									height="96"
									aria-hidden="true"
									hidden></canvas>

								<span class="moon-fallback" aria-hidden="true">
									☾
								</span>
							</span>
						</div>

						<div class="location-time">10:18 PM</div>

						<div class="location-weather">
							<span class="temperature"> 67°F </span>

							<span class="weather-condition"> Clear </span>
						</div>

						<div class="location-timezone">Mountain Time</div>
					</div>
				</div>

				<div class="about-text">
					<h1>Hi, I'm Nick Bournias</h1>

					<p class="light-large">ServiceNow Developer</p>

					<p>
						I’m a developer who enjoys solving complex problems and
						building technology that’s simple, useful, and reliable.
						I specialize in ServiceNow, with a focus on custom
						application development, automation, platform
						engineering, Cyber, and AI.
					</p>

					<p class="light-large">
						Let's connect:
						<a href="mailto:Nick@NickBournias.com"
							>Nick@NickBournias.com</a
						>
					</p>
				</div>
			</div>

			<div class="divider"></div>

			<section class="lower-section">
				<div class="lower-grid">
					<div class="lower-left">
						<!-- YOUR THREE.JS WIDGET -->
						<div class="nb-viz-card">
							<div class="nb-viz-wrap">
								<canvas id="viz"></canvas>
							</div>

							<div class="nb-viz-hint">(click me)</div>
						</div>
					</div>

					<div class="lower-middle">
						<DailyQuote />
					</div>

					<div class="lower-right">
						<div class="harm-card">
							<a
								href="/harmonograph"
								class="harm-link"
								aria-label="Learn more about the daily harmonograph"
							>
								<img
									src="/harmonographs/harmonograph.gif"
									alt="Today's harmonograph"
									class="harm-image"
								/>

							</a>
							<div class="nb-viz-hint">Daily Harmonograph</div>
							<div class="harm-hint">(click to learn more)</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</section>
</BaseLayout>

<script>
	import * as THREE from "three";

	const locations = {
		denver: {
			city: "Denver, CO",
			timeZone: "America/Denver",
			label: "Mountain Time",
			latitude: 39.7392,
			longitude: -104.9903,
		},

		bethesda: {
			city: "Bethesda, MD",
			timeZone: "America/New_York",
			label: "Eastern Time",
			latitude: 38.9847,
			longitude: -77.0947,
		},

		nyc: {
			city: "New York, NY",
			timeZone: "America/New_York",
			label: "Eastern Time",
			latitude: 40.7128,
			longitude: -74.006,
		},

		la: {
			city: "Los Angeles, CA",
			timeZone: "America/Los_Angeles",
			label: "Pacific Time",
			latitude: 34.0522,
			longitude: -118.2437,
		},
	};

	const timeElement = document.querySelector(".location-time");

	const locationName = document.querySelector(".location-name");

	const timezoneElement = document.querySelector(".location-timezone");

	const locationButtons = document.querySelectorAll(".location-option");

	const visitorButton = document.querySelector(".visitor-location");

	const temperatureElement = document.querySelector(".temperature");

	const conditionElement = document.querySelector(".weather-condition");

	const dayNightElement = document.querySelector(".day-night-icon");

	const sunIcon = document.querySelector(".sun-icon");

	const moonCanvas = document.querySelector(".moon-phase-canvas");

	const moonFallback = document.querySelector(".moon-fallback");

	let selectedLocation = "denver";

	const SYNODIC_MONTH = 29.530588853;

	const NEW_MOON_EPOCH = Date.UTC(2000, 0, 6, 18, 14);

	const MILLISECONDS_PER_DAY = 24 * 60 * 60 * 1000;

	function getTimezoneLabel(timeZone) {
		const formatter = new Intl.DateTimeFormat("en-US", {
			timeZone,
			timeZoneName: "long",
		});

		const parts = formatter.formatToParts(new Date());

		return (
			parts.find((part) => part.type === "timeZoneName")?.value ??
			timeZone
		);
	}

	function updateTime() {
		const location = locations[selectedLocation];

		if (!location || !timeElement) return;

		const formatter = new Intl.DateTimeFormat("en-US", {
			timeZone: location.timeZone,
			hour: "numeric",
			minute: "2-digit",
			hour12: true,
		});

		timeElement.textContent = formatter.format(new Date());
	}

	function getWeatherCondition(code) {
		if (code === 0) {
			return "Clear";
		}

		if ([1, 2, 3, 45, 48].includes(code)) {
			return "Cloudy";
		}

		if (
			[51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code)
		) {
			return "Rain";
		}

		if ([71, 73, 75, 77, 85, 86].includes(code)) {
			return "Snow";
		}

		if ([95, 96, 99].includes(code)) {
			return "Storm";
		}

		return "Unknown";
	}

	function renderWeatherLoading() {
		if (temperatureElement) {
			temperatureElement.textContent = "--";
		}

		if (conditionElement) {
			conditionElement.textContent = "Loading";
		}
	}

	function renderWeatherError() {
		if (temperatureElement) {
			temperatureElement.textContent = "--";
		}

		if (conditionElement) {
			conditionElement.textContent = "Unavailable";
		}
	}

	function renderWeather(temperature, weatherCode) {
		if (temperatureElement) {
			temperatureElement.textContent = `${Math.round(temperature)}°F`;
		}

		if (conditionElement) {
			conditionElement.textContent = getWeatherCondition(weatherCode);
		}
	}

	function getMoonPhase(date = new Date()) {
		const daysSinceEpoch =
			(date.getTime() - NEW_MOON_EPOCH) / MILLISECONDS_PER_DAY;

		const cyclePosition = (((daysSinceEpoch / SYNODIC_MONTH) % 1) + 1) % 1;

		const illumination = (1 - Math.cos(2 * Math.PI * cyclePosition)) / 2;

		return {
			phase: cyclePosition,
			illumination,
			name: getMoonPhaseName(cyclePosition),
		};
	}

	function getMoonPhaseName(phase) {
		if (phase < 0.0625 || phase >= 0.9375) {
			return "New Moon";
		}

		if (phase < 0.1875) {
			return "Waxing Crescent";
		}

		if (phase < 0.3125) {
			return "First Quarter";
		}

		if (phase < 0.4375) {
			return "Waxing Gibbous";
		}

		if (phase < 0.5625) {
			return "Full Moon";
		}

		if (phase < 0.6875) {
			return "Waning Gibbous";
		}

		if (phase < 0.8125) {
			return "Last Quarter";
		}

		return "Waning Crescent";
	}

	function renderMoonPhase(location) {
		if (!(moonCanvas instanceof HTMLCanvasElement)) {
			return false;
		}

		const context = moonCanvas.getContext("2d");

		if (!context) {
			return false;
		}

		const { phase, illumination, name } = getMoonPhase();

		const width = moonCanvas.width;
		const height = moonCanvas.height;

		const centerX = width / 2;
		const centerY = height / 2;

		const radius = Math.min(width, height) / 2 - 2;

		const image = context.createImageData(width, height);

		const pixels = image.data;

		/*
			0.00 = New Moon
			0.25 = First Quarter
			0.50 = Full Moon
			0.75 = Last Quarter
		*/
		const phaseAngle = phase * Math.PI * 2;

		/*
			In the Northern Hemisphere, waxing
			illumination appears primarily on the
			right side of the Moon.

			For Southern Hemisphere visitors we
			reverse the horizontal orientation.
		*/
		const hemisphere =
			typeof location?.latitude === "number" && location.latitude < 0
				? -1
				: 1;

		const sunX = Math.sin(phaseAngle) * hemisphere;

		const sunZ = -Math.cos(phaseAngle);

		for (let pixelY = 0; pixelY < height; pixelY++) {
			for (let pixelX = 0; pixelX < width; pixelX++) {
				const x = (pixelX + 0.5 - centerX) / radius;

				const y = (pixelY + 0.5 - centerY) / radius;

				const distanceSquared = x * x + y * y;

				if (distanceSquared > 1) {
					continue;
				}

				const z = Math.sqrt(1 - distanceSquared);

				const lightAmount = x * sunX + z * sunZ;

				const illuminated = lightAmount > 0;

				/*
					Add subtle spherical shading so
					the Moon looks less like a flat
					circle.
				*/
				const limbBrightness = 0.72 + z * 0.28;

				const brightness = illuminated
					? Math.round(235 * limbBrightness)
					: Math.round(20 * limbBrightness);

				const index = (pixelY * width + pixelX) * 4;

				pixels[index] = brightness;

				pixels[index + 1] = brightness;

				pixels[index + 2] = brightness;

				pixels[index + 3] = 255;
			}
		}

		context.clearRect(0, 0, width, height);

		context.putImageData(image, 0, 0);

		const percentage = Math.round(illumination * 100);

		if (dayNightElement) {
			dayNightElement.setAttribute(
				"aria-label",
				`${name}, ${percentage}% illuminated`,
			);

			dayNightElement.setAttribute(
				"title",
				`${name} · ${percentage}% illuminated`,
			);
		}

		return true;
	}

	function renderDayNight(isDay, location) {
		if (isDay) {
			if (sunIcon) {
				sunIcon.hidden = false;
			}

			if (moonCanvas instanceof HTMLCanvasElement) {
				moonCanvas.hidden = true;
			}

			if (moonFallback) {
				moonFallback.hidden = true;
			}

			if (dayNightElement) {
				dayNightElement.setAttribute("aria-label", "Daytime");

				dayNightElement.removeAttribute("title");
			}

			return;
		}

		if (sunIcon) {
			sunIcon.hidden = true;
		}

		try {
			const rendered = renderMoonPhase(location);

			if (!rendered) {
				throw new Error("Moon canvas unavailable");
			}

			if (moonCanvas instanceof HTMLCanvasElement) {
				moonCanvas.hidden = false;
			}

			if (moonFallback) {
				moonFallback.hidden = true;
			}
		} catch (error) {
			console.warn("Moon phase rendering unavailable.", error);

			if (moonCanvas instanceof HTMLCanvasElement) {
				moonCanvas.hidden = true;
			}

			if (moonFallback) {
				moonFallback.hidden = false;
			}

			if (dayNightElement) {
				dayNightElement.setAttribute("aria-label", "Nighttime");
			}
		}
	}

	function getFallbackDayState(location) {
		try {
			const formatter = new Intl.DateTimeFormat("en-US", {
				timeZone: location.timeZone,
				hour: "numeric",
				hourCycle: "h23",
			});

			const parts = formatter.formatToParts(new Date());

			const hour = Number(
				parts.find((part) => part.type === "hour")?.value,
			);

			return hour >= 6 && hour < 18;
		} catch {
			return false;
		}
	}

	async function fetchWeather(location) {
		if (
			typeof location.latitude !== "number" ||
			typeof location.longitude !== "number"
		) {
			renderWeatherError();

			renderDayNight(getFallbackDayState(location), location);

			return;
		}

		renderWeatherLoading();

		try {
			const params = new URLSearchParams({
				latitude: location.latitude.toString(),
				longitude: location.longitude.toString(),
				current: "temperature_2m,weather_code,is_day",
				temperature_unit: "fahrenheit",
			});

			const response = await fetch(
				`https://api.open-meteo.com/v1/forecast?${params}`,
			);

			if (!response.ok) {
				throw new Error("Weather request failed");
			}

			const data = await response.json();

			const temperature = data.current?.temperature_2m;

			const weatherCode = data.current?.weather_code;

			const isDay = data.current?.is_day;

			if (
				typeof temperature !== "number" ||
				typeof weatherCode !== "number"
			) {
				throw new Error("Incomplete weather data");
			}

			renderWeather(temperature, weatherCode);

			if (isDay === 0 || isDay === 1) {
				renderDayNight(isDay === 1, location);
			} else {
				renderDayNight(getFallbackDayState(location), location);
			}
		} catch (error) {
			console.warn("Weather unavailable.", error);

			renderWeatherError();

			renderDayNight(getFallbackDayState(location), location);
		}
	}

	function selectLocation(locationKey) {
		const location = locations[locationKey];

		if (!location) return;

		selectedLocation = locationKey;

		if (locationName) {
			locationName.textContent = location.city;
		}

		if (timezoneElement) {
			timezoneElement.textContent = location.label;
		}

		locationButtons.forEach((button) => {
			button.classList.toggle(
				"active",
				button.dataset.location === selectedLocation,
			);
		});

		updateTime();

		/*
			Render immediately using the timezone
			while waiting for Open-Meteo to return
			the more accurate day/night state.
		*/
		renderDayNight(getFallbackDayState(location), location);

		fetchWeather(location);
	}

	async function detectVisitorLocation() {
		try {
			const response = await fetch("https://ipapi.co/json/");

			if (!response.ok) {
				throw new Error("Location lookup failed");
			}

			const data = await response.json();

			if (
				!data.city ||
				!data.timezone ||
				typeof data.latitude !== "number" ||
				typeof data.longitude !== "number"
			) {
				throw new Error("Incomplete location data");
			}

			const region = data.region_code ? `, ${data.region_code}` : "";

			locations.you = {
				city: `${data.city}${region}`,
				timeZone: data.timezone,
				label: getTimezoneLabel(data.timezone),
				latitude: data.latitude,
				longitude: data.longitude,
			};

			if (visitorButton) {
				visitorButton.hidden = false;
			}
		} catch (error) {
			console.warn("Visitor location unavailable.", error);

			if (visitorButton) {
				visitorButton.hidden = true;
			}
		}
	}

	const canvas = document.getElementById("viz");

	if (canvas instanceof HTMLCanvasElement) {
		const scene = new THREE.Scene();

		const camera = new THREE.PerspectiveCamera(70, 1, 0.01, 20);

		camera.position.z = 1.05;

		const renderer = new THREE.WebGLRenderer({
			canvas,
			antialias: true,
			alpha: true,
		});

		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

		function resizeViz() {
			const r = canvas.getBoundingClientRect();

			const w = Math.max(1, Math.floor(r.width));

			const h = Math.max(1, Math.floor(r.height));

			renderer.setSize(w, h, false);

			camera.aspect = w / h;

			camera.updateProjectionMatrix();
		}

		window.addEventListener("resize", resizeViz, {
			passive: true,
		});

		resizeViz();

		const vizMaterial = new THREE.ShaderMaterial({
			transparent: true,

			side: THREE.FrontSide,

			uniforms: {
				uTime: {
					value: 0,
				},

				uPlay: {
					value: 0,
				},

				uAmp: {
					value: 0,
				},

				uBass: {
					value: 0,
				},

				uMid: {
					value: 0,
				},

				uHigh: {
					value: 0,
				},

				uKick: {
					value: 0,
				},

				uSnare: {
					value: 0,
				},
			},

			vertexShader: `
				uniform float uTime;
				uniform float uPlay;
				uniform float uAmp;
				uniform float uBass;
				uniform float uMid;
				uniform float uHigh;
				uniform float uKick;
				uniform float uSnare;

				varying vec3 vPos;

				void main() {
					float t = uTime * 0.8;

					float wave =
						sin(position.x * 4.0 + t) +
						sin(position.y * 5.0 + t * 1.1) +
						sin(position.z * 6.0 + t * 0.9);

					vec3 displaced =
						position * (1.0 + 0.06 * wave);

					float detail =
						sin(
							position.x * 10.0 +
							t * 1.5
						) *
						sin(
							position.y * 9.0 +
							t * 1.2
						) *
						sin(
							position.z * 8.0 +
							t * 1.0
						);

					float distort =
						(0.02 * uPlay) +
						(0.06 * uPlay * uBass);

					displaced +=
						normalize(normal) *
						detail *
						distort;

					float thump =
						(0.10 * uKick) +
						(0.07 * uSnare);

					float kickShape =
						sin(
							t * 8.0 +
							position.y * 5.0
						);

					displaced +=
						normalize(normal) *
						kickShape *
						(0.035 * uKick);

					float snareShape =
						sin(
							position.x * 28.0 +
							t * 14.0
						) *
						sin(
							position.z * 24.0 +
							t * 12.0
						);

					displaced +=
						normalize(normal) *
						snareShape *
						(0.018 * uSnare);

					displaced *=
						(
							1.0 +
							0.02 * uPlay * uAmp +
							0.01 * thump
						);

					vPos = displaced;

					gl_Position =
						projectionMatrix *
						modelViewMatrix *
						vec4(
							displaced,
							1.0
						);
				}
			`,

			fragmentShader: `
				uniform float uTime;
				uniform float uPlay;
				uniform float uAmp;
				uniform float uBass;
				uniform float uMid;
				uniform float uHigh;
				uniform float uKick;
				uniform float uSnare;

				varying vec3 vPos;

				vec3 palette(float t) {
					vec3 a =
						vec3(0.5);

					vec3 b =
						vec3(0.5);

					vec3 c =
						vec3(1.0);

					vec3 d =
						vec3(
							0.00,
							0.33,
							0.67
						);

					return
						a +
						b *
						cos(
							6.28318 *
							(
								c * t +
								d
							)
						);
				}

				void main() {
					if (!gl_FrontFacing) {
						discard;
					}

					vec3 p =
						normalize(vPos);

					float baseT =
						length(vPos) * 1.8 +
						uTime * 0.12;

					float phase =
						baseT +
						uPlay * (0.35 * uMid) +
						uPlay * (0.18 * uHigh) -
						uPlay * (0.10 * uBass);

					phase +=
						0.22 * uKick +
						0.18 * uSnare;

					vec3 col =
						palette(phase);

					float lift =
						1.0 +
						uPlay *
						(
							0.25 * uAmp +
							0.15 * uHigh
						);

					col *= lift;

					col =
						mix(
							col,
							col + 0.12,
							uPlay * 0.35
						);

					col +=
						uKick *
						vec3(
							0.10,
							0.06,
							0.02
						);

					col +=
						uSnare *
						vec3(
							0.04,
							0.06,
							0.10
						);

					float rim =
						1.0 -
						smoothstep(
							0.35,
							1.0,
							abs(p.z)
						);

					col +=
						rim *
						(
							0.06 +
							0.10 * uPlay
						) +
						rim *
						(
							0.08 * uKick +
							0.06 * uSnare
						);

					gl_FragColor =
						vec4(
							col,
							1.0
						);
				}
			`,
		});

		const SPHERE_RADIUS = 0.45;

		const sphereGeo = new THREE.SphereGeometry(SPHERE_RADIUS, 160, 160);

		const sphere = new THREE.Mesh(sphereGeo, vizMaterial);

		scene.add(sphere);

		const GROW_DURATION = 1.25;

		const GROW_START_SCALE = 0.02;

		let growStart = performance.now() * 0.001;

		sphere.scale.setScalar(GROW_START_SCALE);

		function smoothstep01(x) {
			x = Math.min(Math.max(x, 0), 1);

			return x * x * (3.0 - 2.0 * x);
		}

		const raycaster = new THREE.Raycaster();

		const mouse = new THREE.Vector2();

		let vizState = "idle";

		let bubbles = [];

		let explodeStart = 0;

		const BUBBLE_COUNT = 90;

		const BUBBLE_RADIUS = 0.045;

		const EXPLODE_DURATION = 1.0;

		const HOLD_DURATION = 0.6;

		const RETURN_DURATION = 1.2;

		const OUTWARD_IMPULSE_MIN = 0.02;

		const OUTWARD_IMPULSE_MAX = 0.035;

		const DRAG_EXPLODE = 0.985;

		const DRAG_RETURN = 0.9;

		const BOUNCE_RADIUS = 1.1;

		function resetToSphere() {
			for (const bubble of bubbles) {
				scene.remove(bubble);

				bubble.geometry.dispose();

				bubble.material.dispose();
			}

			bubbles = [];

			sphere.visible = true;

			vizState = "idle";
		}

		function makeBubbles() {
			bubbles = [];

			for (let i = 0; i < BUBBLE_COUNT; i++) {
				const bubbleGeo = new THREE.SphereGeometry(
					BUBBLE_RADIUS,
					24,
					24,
				);

				const bubbleMaterial = vizMaterial.clone();

				bubbleMaterial.uniforms = {
					uTime: {
						value: 0,
					},

					uPlay: {
						value: 0,
					},

					uAmp: {
						value: 0,
					},

					uBass: {
						value: 0,
					},

					uMid: {
						value: 0,
					},

					uHigh: {
						value: 0,
					},

					uKick: {
						value: 0,
					},

					uSnare: {
						value: 0,
					},
				};

				const bubble = new THREE.Mesh(bubbleGeo, bubbleMaterial);

				const dir = new THREE.Vector3(
					Math.random() * 2 - 1,
					Math.random() * 2 - 1,
					Math.random() * 2 - 1,
				);

				if (dir.lengthSq() < 1e-6) {
					dir.set(1, 0, 0);
				}

				dir.normalize();

				const home = dir
					.clone()
					.multiplyScalar(
						SPHERE_RADIUS * (0.95 + Math.random() * 0.1),
					);

				bubble.position.copy(home);

				const impulse =
					OUTWARD_IMPULSE_MIN +
					Math.random() * (OUTWARD_IMPULSE_MAX - OUTWARD_IMPULSE_MIN);

				bubble.userData.vel = dir.clone().multiplyScalar(impulse);

				bubble.userData.home = home;

				scene.add(bubble);

				bubbles.push(bubble);
			}
		}

		function explodeAndReturn() {
			if (vizState !== "idle") {
				return;
			}

			explodeStart = performance.now() * 0.001;

			vizState = "explode";

			sphere.visible = false;

			makeBubbles();
		}

		canvas.addEventListener(
			"pointerdown",
			(event) => {
				if (vizState !== "idle") {
					return;
				}

				const r = canvas.getBoundingClientRect();

				mouse.x = ((event.clientX - r.left) / r.width) * 2 - 1;

				mouse.y = -(((event.clientY - r.top) / r.height) * 2 - 1);

				raycaster.setFromCamera(mouse, camera);

				const hit = raycaster.intersectObject(sphere, false);

				if (hit.length) {
					explodeAndReturn();
				}
			},
			{
				passive: true,
			},
		);

		const tmp = new THREE.Vector3();

		const tmp2 = new THREE.Vector3();

		function pushUniforms(mat) {
			mat.uniforms.uTime.value = vizMaterial.uniforms.uTime.value;

			mat.uniforms.uPlay.value = 0;

			mat.uniforms.uAmp.value = 0;

			mat.uniforms.uBass.value = 0;

			mat.uniforms.uMid.value = 0;

			mat.uniforms.uHigh.value = 0;

			mat.uniforms.uKick.value = 0;

			mat.uniforms.uSnare.value = 0;
		}

		function animateViz(ms) {
			const t = ms * 0.001;

			vizMaterial.uniforms.uTime.value = t;

			if (sphere.visible) {
				const g = (t - growStart) / GROW_DURATION;

				const eased = smoothstep01(g);

				const scale = THREE.MathUtils.lerp(
					GROW_START_SCALE,
					1.0,
					eased,
				);

				sphere.scale.setScalar(scale);
			}

			if (vizState === "idle") {
				sphere.rotation.y = t * 0.35;

				sphere.rotation.x = t * 0.18;
			}

			if (vizState === "explode" || vizState === "return") {
				const elapsed = t - explodeStart;

				if (
					vizState === "explode" &&
					elapsed > EXPLODE_DURATION + HOLD_DURATION
				) {
					vizState = "return";
				}

				if (
					vizState === "return" &&
					elapsed > EXPLODE_DURATION + HOLD_DURATION + RETURN_DURATION
				) {
					resetToSphere();
				}

				for (const bubble of bubbles) {
					pushUniforms(bubble.material);

					const vel = bubble.userData.vel;

					if (vizState === "explode") {
						vel.multiplyScalar(DRAG_EXPLODE);

						vel.x += (Math.random() - 0.5) * 0.00045;

						vel.y += (Math.random() - 0.5) * 0.00045;

						vel.z += (Math.random() - 0.5) * 0.00045;

						bubble.position.add(vel);

						const d = bubble.position.length();

						if (d > BOUNCE_RADIUS) {
							const n = tmp
								.copy(bubble.position)
								.multiplyScalar(1 / d);

							const vn = vel.dot(n);

							tmp2.copy(n).multiplyScalar(2 * vn);

							vel.sub(tmp2);

							bubble.position.copy(
								n.multiplyScalar(BOUNCE_RADIUS),
							);

							vel.multiplyScalar(0.85);
						}
					} else {
						vel.multiplyScalar(DRAG_RETURN);

						tmp.copy(bubble.userData.home).sub(bubble.position);

						vel.add(tmp.multiplyScalar(0.06));

						bubble.position.add(vel);
					}
				}
			}

			renderer.render(scene, camera);

			requestAnimationFrame(animateViz);
		}

		requestAnimationFrame(animateViz);
	}

	locationButtons.forEach((button) => {
		button.addEventListener("click", () => {
			const locationKey = button.dataset.location;

			if (locationKey && locationKey in locations) {
				selectLocation(locationKey);
			}
		});
	});

	updateTime();

	renderDayNight(
		getFallbackDayState(locations[selectedLocation]),
		locations[selectedLocation],
	);

	fetchWeather(locations[selectedLocation]);

	setInterval(updateTime, 1000);

	/*
		Refresh weather and day/night every
		10 minutes.
	*/
	setInterval(
		() => {
			const location = locations[selectedLocation];

			if (location) {
				fetchWeather(location);
			}
		},
		10 * 60 * 1000,
	);

	detectVisitorLocation();
</script>

