---
import BaseLayout from "../layouts/BaseLayout.astro";
import DailyQuote from "../components/DailyQuote.astro";
import InteractiveSphere from "../components/home/InteractiveSphere.astro";
import HarmonographCard from "../components/home/HarmonographCard.astro";
import LocationWidget from "../components/home/LocationWidget.astro";
---

<BaseLayout
	title="Nick Bournias"
	description="Personal website of Nick Bournias"
>
	<section class="about-section">
		<div class="container">
			<div class="about-grid">
				<div class="about-extra">
					<div class="hero-widget">
						<div class="hero-flipper">
							<div class="headshot-layer">
								<div class="headshot-wrap">
									<img
										src="/assets/images/nick-bournias-headshot.jpg"
										alt="Nick Bournias"
										class="headshot"
									/>
								</div>
							</div>

							<div class="weather-layer">
								<LocationWidget />
							</div>
						</div>
					</div>
				</div>

				<div class="about-text">
					<h1>Hi, I'm Nick Bournias</h1>

					<p class="light-large">ServiceNow Developer</p>

					<p>
						I’m a developer who enjoys solving complex problems and
						building technology that’s simple, useful, and reliable.
						I specialize in ServiceNow, with a focus on custom
						application development, automation, platform
						engineering, Cyber, and AI.
					</p>

					<div class="connect">
						<p class="light-large">Let's connect:</p>

						<div class="social-links">
							<a href="mailto:Nick@NickBournias.com"> Email ↗ </a>

							<a
								href="https://www.linkedin.com/in/nickbournias/"
								target="_blank"
								rel="noopener noreferrer"
							>
								LinkedIn ↗
							</a>

							<a
								href="https://github.com/nickbournias"
								target="_blank"
								rel="noopener noreferrer"
							>
								GitHub ↗
							</a>
						</div>
					</div>
				</div>
			</div>

			<div class="divider"></div>

			<section class="middle-section">
				<div class="middle-grid">
					<div class="middle-left scroll-reveal">
						<InteractiveSphere />
					</div>

					<div class="middle-center scroll-reveal">
						<DailyQuote />
					</div>

					<div class="middle-right scroll-reveal">
						<HarmonographCard />
					</div>
				</div>
			</section>

			<div class="divider"></div>

			<section class="page-links-section scroll-reveal-links">
				<div class="page-links-grid">
					<a href="/portfolio" class="nb-tile-link">
						<div class="nb-tile">
							<div class="nb-tile-eyebrow">Collection</div>
							<div class="nb-tile-title">Portfolio</div>
							<div class="nb-tile-desc">
								A collection of engineering, automation, performance, and platform problems I’ve solved in ServiceNow.
							</div>
						</div>
					</a>

					<a href="/writings" class="nb-tile-link">
						<div class="nb-tile">
							<div class="nb-tile-eyebrow">Research</div>
							<div class="nb-tile-title">Writings</div>
							<div class="nb-tile-desc">
								A collection of thoughts on technology, AI, development, work, and whatever else I find interesting.
							</div>
						</div>
					</a>

					<a href="/apps" class="nb-tile-link">
						<div class="nb-tile">
							<div class="nb-tile-eyebrow">Interactive</div>
							<div class="nb-tile-title">Apps</div>
							<div class="nb-tile-desc">
								Some small apps I've created for fun. Audio
								visualizers, games, and more!
							</div>
						</div>
					</a>

					<a href="/about-me" class="nb-tile-link">
						<div class="nb-tile">
							<div class="nb-tile-eyebrow">Bio</div>
							<div class="nb-tile-title">About Me</div>
							<div class="nb-tile-desc">
								More about who I am and my life.
							</div>
						</div>
					</a>
				</div>
			</section>
		</div>
	</section>
</BaseLayout>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const mm = gsap.matchMedia();

	mm.add("(max-width: 767px)", () => {
		const items = document.querySelectorAll(".scroll-reveal");

		items.forEach((item) => {
			gsap.fromTo(
				item,
				{
					opacity: 0,
					y: 40,
				},
				{
					opacity: 1,
					y: 0,
					duration: 0.8,
					ease: "power2.out",

					scrollTrigger: {
						trigger: item,
						start: "center 80%",
						once: true,

						onEnter: () => {
							if (item.classList.contains("middle-left")) {
								document.dispatchEvent(
									new CustomEvent("init-interactive-sphere"),
								);
							}

							if (item.classList.contains("middle-center")) {
								document.dispatchEvent(
									new CustomEvent("init-daily-quote"),
								);
							}
						},
					},
				},
			);
		});
	});

	mm.add("(min-width: 768px)", () => {
		document.dispatchEvent(new CustomEvent("init-interactive-sphere"));

		document.dispatchEvent(new CustomEvent("init-daily-quote"));
	});

	gsap.fromTo(
		".nb-tile-link",
		{
			opacity: 0,
			y: 35,
		},
		{
			opacity: 1,
			y: 0,
			duration: 0.7,
			stagger: 0.1,
			ease: "power2.out",

			scrollTrigger: {
				trigger: ".page-links-section",
				start: "center 80%",
				once: true,
			},
		},
	);

	let heroSwapped = false;

	function flipHeroWidget() {
		if (heroSwapped) return;

		const flipper = document.querySelector(".hero-flipper");

		if (!(flipper instanceof HTMLElement)) return;

		heroSwapped = true;
		flipper.classList.add("is-flipped");
	}

	window.addEventListener("scroll", flipHeroWidget, {
		once: true,
		passive: true,
	});
</script>

<style>
	.about-section {
		padding-top: 4rem;
		padding-bottom: 3rem;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	.about-extra {
		display: flex;
		justify-content: center;
		width: 100%;
		min-width: 0;
	}

	.hero-widget {
		width: min(100%, 390px);
		min-width: 0;
		perspective: 1200px;
	}

	.hero-flipper {
		position: relative;
		width: 100%;
		min-height: 270px;
		transform-style: preserve-3d;
		transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hero-flipper.is-flipped {
		transform: rotateY(180deg);
	}

	.headshot-layer,
	.weather-layer {
		position: absolute;
		inset: 0;

		display: flex;
		align-items: center;
		justify-content: center;

		width: 100%;
		min-width: 0;

		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}

	.headshot-layer {
		z-index: 2;
	}

	.weather-layer {
		z-index: 1;
		transform: rotateY(180deg) scale(1.04);
	}

	.headshot-wrap {
		width: min(100%, 285px);
		aspect-ratio: 1 / 1;

		border-radius: 20px;
		overflow: hidden;
	}

	.headshot {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;
		object-position: center;

		transform: scale(1.2);
	}

	.about-text h1 {
		margin-bottom: 15px;

		font-size: clamp(1.9rem, 5vw, 2.4rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: 0;
	}

	.about-text h2 {
		margin-bottom: 1.5rem;

		color: var(--muted);

		font-size: 1.25rem;
		font-weight: 400;
	}

	.about-text p {
		max-width: 650px;

		color: var(--muted);

		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.6;
	}

	.about-text p.light {
		color: #cbcbcb;
	}

	.about-text p.light-large {
		color: #cbcbcb;
		font-size: 1.4rem;
	}

	.light-large a {
		margin-left: 6px;
		text-decoration: underline;
	}

	.divider {
		width: 55%;
		height: 1px;
		margin: 30px auto;

		background-color: rgba(255, 255, 255, 0.2);
	}

	.middle-section {
		padding: 1rem 0;
	}

	.middle-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.middle-center {
		display: flex;
		align-items: center;
		justify-content: center;

		min-width: 0;

		text-align: center;
	}

	.page-links-section {
		padding-top: 1rem;
	}

	.page-links-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		width: 90%;
		margin-inline: auto;
	}

	.nb-tile-link {
		display: block;

		width: 100%;
		margin: 0;

		color: inherit;
		text-decoration: none;
	}

	.nb-tile {
		height: 100%;
		min-height: 170px;

		padding: 24px 28px;

		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;

		background: rgba(255, 255, 255, 0.04);

		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);

		transition:
			transform 0.22s ease,
			background 0.22s ease,
			box-shadow 0.22s ease;
	}

	.nb-tile-link:hover .nb-tile,
	.nb-tile-link:focus-visible .nb-tile {
		background: rgba(255, 255, 255, 0.07);

		transform: translateY(-2px);

		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
	}

	.nb-tile-eyebrow {
		margin-bottom: 8px;

		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;

		opacity: 0.6;
	}

	.nb-tile-title {
		margin-bottom: 8px;

		font-size: 22px;
		font-weight: 600;
		line-height: 1.2;
	}

	.nb-tile-desc {
		font-size: 14px;
		line-height: 1.5;

		opacity: 0.75;
	}

	.connect {
		margin-top: 1.5rem;

		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.connect-label {
		margin: 0;
	}

	.connect .light-large {
		margin-bottom: 0.5rem;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.social-links a {
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: none;

		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}

	.social-links a:hover {
		color: #fff;
		transform: translateY(-1px);
	}

	@media (max-width: 767px) {
		.about-section {
			padding-top: 3rem;
			padding-bottom: 3rem;
		}

		.about-grid {
			gap: 2rem;
		}

		.about-extra {
			justify-content: center;
		}

		.hero-widget {
			width: calc(100% + 48px);
			max-width: 430px;
			margin-inline: -24px;

			perspective: 1000px;
		}

		.hero-flipper {
			min-height: 275px;
		}

		.headshot-wrap {
			width: min(82%, 285px);
		}

		.weather-layer {
			transform: rotateY(180deg) scale(1.1);
		}

		.about-text p.light-large {
			font-size: 1.1rem;
		}

		.middle-center {
			padding-top: 1rem;
		}

		.middle-left {
			padding-bottom: 1rem;
		}

		.nb-tile {
			min-height: auto;
			padding: 20px;
		}

		.nb-tile-title {
			font-size: 18px;
		}
	}

	@media (min-width: 768px) {
		.about-grid {
			grid-template-columns: 2fr 3fr;
			align-items: center;
		}

		.about-extra {
			justify-content: flex-end;
		}

		.headshot-layer {
			justify-content: flex-end;
		}

		.middle-grid {
			grid-template-columns: 2fr 4fr 2fr;
		}

		.middle-center {
			transform: translateY(-50px);
		}

		.page-links-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-flipper,
		.nb-tile {
			transition: none;
		}
	}
</style>
