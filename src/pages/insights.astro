
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import TypedText from "../components/TypedText.astro";

const insights = (await getCollection("insights")).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const formatDate = (date: Date | string) =>
    new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
    }).format(new Date(date));
---

<BaseLayout
    title="Insights - Nick Bournias"
    description="Personal insights of Nick Bournias"
>
    <section class="page-section">
        <div class="container">
            <header class="page-header">
                <p class="eyebrow">Insights</p>
                <h1 class="page-title">Things worth thinking about.</h1>
                <p class="page-intro">
                    <TypedText text="A collection of thoughts on technology, AI, development, work, and whatever else I find interesting." />
                </p>
            </header>

            <div class="divider"></div>

            <div class="writing-list">
                {
                    insights.map((insight) => (
                        <article class="writing-entry">
                            <div class="writing-meta">
                                <time datetime={new Date(insight.data.date).toISOString()}>
                                    {formatDate(insight.data.date)}
                                </time>
                                {insight.data.category && (
                                    <span>{insight.data.category}</span>
                                )}
                            </div>

                            <a
                                class="writing-link"
                                href={`/insights/${insight.id}/`}
                            >
                                <h2>{insight.data.title}</h2>
                                <p>{insight.data.description}</p>
                                <span class="read-link">Read essay</span>
                            </a>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .divider {
        width: 100%;
        height: 1px;
        background: rgba(255, 255, 255, 0.12);
    }

    .writing-list {
        margin-top: 1rem;
    }

    .writing-entry {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 3rem;
        padding: 3rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .writing-meta {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        padding-top: 0.4rem;
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .writing-link {
        display: block;
        max-width: 820px;
        color: inherit;
        text-decoration: none;
    }

    .writing-link h2 {
        margin: 0;
        max-width: 760px;
        color: rgba(255, 255, 255, 0.96);
        font-size: clamp(1.9rem, 3vw, 2.7rem);
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.035em;
        transition: transform 0.25s ease, color 0.25s ease;
    }

    .writing-link p {
        margin: 1rem 0 0;
        max-width: 700px;
        color: rgba(255, 255, 255, 0.46);
        font-size: 1rem;
        line-height: 1.7;
    }

    .read-link {
        display: inline-block;
        margin-top: 1.35rem;
        padding-bottom: 0.2rem;
        color: rgba(255, 255, 255, 0.58);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(255, 255, 255, 0.18);
        transition: color 0.25s ease, border-color 0.25s ease;
    }

    .writing-entry:hover .writing-link h2 {
        transform: translateX(4px);
        color: #ffffff;
    }

    .writing-entry:hover .read-link {
        color: rgba(255, 255, 255, 0.9);
        border-color: rgba(255, 255, 255, 0.5);
    }

    @media (max-width: 767px) {
        .writing-entry {
            grid-template-columns: 1fr;
            gap: 1rem;
            padding: 2.25rem 0;
        }

        .writing-meta {
            padding-top: 0;
        }

        .writing-link h2 {
            font-size: 1.7rem;
        }

        .writing-link p {
            font-size: 0.95rem;
        }

        .read-link {
            margin-top: 1.1rem;
        }
    }
</style>
