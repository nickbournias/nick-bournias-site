---
import BaseLayout from "../layouts/BaseLayout.astro";
import TypedText from "../components/TypedText.astro";

const apps = [
    {
        title: "Bike Map",
        category: "Maps / Cycling",
        description:
            "An interactive bike map built for exploring routes and cycling infrastructure.",
        href: "https://nickbournias.github.io/bike-map/",
        tech: ["JavaScript", "Web"],
        external: true,
    },
    {
        title: "Harmonograph",
        category: "Generative Art",
        description:
            "An interactive exploration of harmonographs and the geometric patterns created by simulated pendulum motion.",
        href: "/harmonograph",
        tech: ["JavaScript", "Canvas", "Generative Art"],
        external: false,
    },
    {
        title: "BPM Detector",
        category: "Audio",
        description:
            "A lightweight browser tool for estimating the tempo of music in beats per minute.",
        href: "https://nickbournias.github.io/bpm-detector/",
        tech: ["JavaScript", "Audio"],
        external: true,
    },
    {
        title: "Password Generator",
        category: "Utility",
        description:
            "A simple browser-based tool for quickly generating randomized passwords.",
        href: "https://nickbournias.github.io/password-generator/",
        tech: ["JavaScript", "Web"],
        external: true,
    },
    {
        title: "Duck Hunt",
        category: "Game",
        description:
            "A small browser game inspired by the classic arcade-style duck hunting experience.",
        href: "https://nickbournias.github.io/duck-hunt/",
        tech: ["JavaScript", "Game"],
        external: true,
    },
    {
        title: "Ambient Visualizer",
        category: "Audio / Visual",
        description:
            "An experimental ambient audio visualizer built around sound, motion, and color.",
        href: "https://nickbournias.github.io/ambient-visualizer/",
        tech: ["JavaScript", "Audio", "Visuals"],
        external: true,
    },
];
---

<BaseLayout
    title="Apps - Nick Bournias"
    description="Apps created by Nick Bournias"
>
    <section class="apps-section">
        <div class="container">
            <header class="apps-header">
                <p class="eyebrow">Apps</p>

                <h1>Things I’ve built.</h1>

                <p class="intro">
                    <TypedText
                        text="Some small apps I've created for fun. Audio visualizers, games, utilities, and more."
                    />
                </p>

                <p class="mobile-note">
                    Some projects are best experienced on desktop.
                </p>
            </header>

            <div class="divider"></div>

            <div class="apps-list">
                {
                    apps.map((app) => (
                        <a
                            class="app-entry"
                            href={app.href}
                            target={app.external ? "_blank" : undefined}
                            rel={
                                app.external ? "noopener noreferrer" : undefined
                            }
                        >
                            <div class="app-content">
                                <div class="app-meta">
                                    <span>{app.category}</span>
                                </div>

                                <h2>{app.title}</h2>

                                <p>{app.description}</p>

                                <div class="app-tech">
                                    {app.tech.map((item) => (
                                        <span>{item}</span>
                                    ))}
                                </div>
                            </div>

                            <div class="app-arrow" aria-hidden="true">
                                ↗︎
                            </div>
                        </a>
                    ))
                }
            </div>

            <div class="github-footer">
                <p>
                    More projects and source code on
                    <a
                        href="https://github.com/nickbournias"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        GitHub ↗︎
                    </a>
                </p>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .apps-section {
        padding: 5rem 0 6rem;
    }

    .container {
        width: 100%;
        padding-inline: 1.25rem;
    }

    .apps-header {
        max-width: 760px;
    }

    .eyebrow {
        margin: 0 0 1rem;

        color: rgba(255, 255, 255, 0.42);

        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;

        font-size: clamp(2.4rem, 6vw, 4.4rem);
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: -0.035em;
    }

    .intro {
        max-width: 620px;

        margin: 1.6rem 0 0;

        color: var(--muted);

        font-size: clamp(1rem, 2vw, 1.2rem);
        line-height: 1.65;
    }

    .mobile-note {
        margin: 0.9rem 0 0;

        color: rgba(255, 255, 255, 0.3);

        font-size: 0.75rem;
    }

    .divider {
        width: 100%;
        height: 1px;

        margin-top: 4rem;

        background: rgba(255, 255, 255, 0.12);
    }

    .apps-list {
        width: 100%;
    }

    .app-entry {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 2rem;
        align-items: center;

        padding: 2.5rem 0;

        border-bottom: 1px solid rgba(255, 255, 255, 0.1);

        color: inherit;
        text-decoration: none;
    }

    .app-content {
        width: 100%;
        max-width: none;
    }

    .app-meta {
        display: flex;
        gap: 0.7rem;

        margin-bottom: 0.75rem;

        color: rgba(255, 255, 255, 0.3);

        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .app-content h2 {
        margin: 0;

        color: rgba(255, 255, 255, 0.95);

        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 400;
        line-height: 1.15;
        letter-spacing: -0.025em;

        transition: transform 0.25s ease;
    }

    .app-content p {
        max-width: 620px;

        margin: 0.75rem 0 0;

        color: rgba(255, 255, 255, 0.45);

        font-size: 0.92rem;
        line-height: 1.65;
    }

    .app-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;

        margin-top: 1rem;
    }

    .app-tech span {
        padding: 0.25rem 0.55rem;

        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;

        color: rgba(255, 255, 255, 0.35);

        font-size: 0.64rem;
    }

    .app-arrow {
        color: rgba(255, 255, 255, 0.25);

        font-size: 1.2rem;

        transition:
            transform 0.25s ease,
            color 0.25s ease;
    }

    .app-entry:hover .app-content h2 {
        transform: translateX(3px);
    }

    .app-entry:hover .app-arrow {
        transform: translate(3px, -3px);

        color: rgba(255, 255, 255, 0.75);
    }

    .github-footer {
        padding-top: 2.5rem;

        color: rgba(255, 255, 255, 0.35);

        font-size: 0.8rem;
    }

    .github-footer p {
        margin: 0;
    }

    .github-footer a {
        margin-left: 0.3rem;

        color: rgba(255, 255, 255, 0.65);
        text-decoration: none;

        transition: color 0.2s ease;
    }

    .github-footer a:hover {
        color: white;
    }

    .typing-cursor {
        display: inline-block;

        width: 0.35em;
        height: 1em;

        margin-left: 3px;

        background: currentColor;

        vertical-align: -0.12em;
        opacity: 1;
    }

    .typing-cursor.blink {
        animation: cursor-blink 0.8s step-end infinite;
    }

    @keyframes cursor-blink {
        50% {
            opacity: 0;
        }
    }

    @media (max-width: 767px) {
        .apps-section {
            padding: 3.5rem 0 4rem;
        }

        h1 {
            font-size: 2.35rem;
        }

        .intro {
            margin-top: 1.25rem;
        }

        .divider {
            margin-top: 3rem;
        }

        .app-entry {
            grid-template-columns: 1fr;
            gap: 0;

            padding: 2rem 0;
        }

        .app-arrow {
            display: none;
        }

        .app-meta {
            margin-bottom: 0.5rem;

            font-size: 0.6rem;
        }

        .app-content h2 {
            font-size: 1.35rem;
        }

        .app-content p {
            margin-top: 0.6rem;

            font-size: 0.85rem;
            line-height: 1.55;
        }

        .app-tech {
            margin-top: 0.8rem;
        }

        .github-footer {
            padding-top: 2rem;
        }
    }
</style>
