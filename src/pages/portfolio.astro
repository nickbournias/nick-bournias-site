---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Apps - Nick Bournias"
	,
	description="Apps created by Nick Bournias"
>
	<section class="about-section">
		
	</section>
</BaseLayout>

<style>
	.hero {
		flex: 1;

		display: flex;
		align-items: center;
	}

	.hero-content {
		max-width: 850px;
	}

	.eyebrow {
		margin-bottom: 16px;

		color: var(--muted);
		font-size: 1rem;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 5rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: 0;
	}

	.intro {
		margin: 0;

		color: var(--muted);

		font-size: clamp(1.1rem, 2vw, 1.4rem);
	}

	.container {
		width: min(100% - 2rem, 1200px);
		margin-inline: auto;
	}

	.about-section {
		padding: 5rem 0;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	/* Desktop enhancement */
	@media (min-width: 768px) {
		.about-grid {
			grid-template-columns: 1fr 2fr;
			align-items: end;
		}
	}
</style>
