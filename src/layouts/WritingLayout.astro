---
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title: string;
	description: string;
	date: Date | string;
	category?: string;
}

const {
	title,
	description,
	date,
	category,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
}).format(new Date(date));
---

<BaseLayout
	title={`${title} - Nick Bournias`}
	description={description}
>
	<main class="article-page">
		<div class="article-container">
			<a class="back-link" href="/writings">
				← Writings
			</a>

			<header class="article-header">
				<div class="article-meta">
					<time datetime={new Date(date).toISOString()}>
						{formattedDate}
					</time>

					{category && (
						<>
							<span class="meta-divider">•</span>
							<span>{category}</span>
						</>
					)}
				</div>

				<h1>{title}</h1>

				<p class="article-description">
					{description}
				</p>
			</header>

			<div class="header-divider"></div>

			<article class="article-body">
				<slot />
			</article>

			<footer class="article-footer">
				<div class="footer-divider"></div>

				<a href="/writings">
					← Back to writings
				</a>
			</footer>
		</div>
	</main>
</BaseLayout>

<style>
	.article-page {
		padding: 4rem 0 6rem;
	}

	.article-container {
		width: min(100% - 2rem, 900px);
		margin-inline: auto;
	}

	.back-link {
		display: inline-block;

		margin-bottom: 4rem;

		color: rgba(255, 255, 255, 0.4);

		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.04em;

		text-decoration: none;

		transition: color 0.2s ease;
	}

	.back-link:hover {
		color: rgba(255, 255, 255, 0.8);
	}

	.article-header {
		max-width: 850px;
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;

		margin-bottom: 1.5rem;

		color: rgba(255, 255, 255, 0.35);

		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.meta-divider {
		color: rgba(255, 255, 255, 0.18);
	}

	h1 {
		margin: 0;

		max-width: 850px;

		font-size: clamp(2.6rem, 7vw, 5rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.045em;
	}

	.article-description {
		max-width: 680px;

		margin: 1.75rem 0 0;

		color: rgba(255, 255, 255, 0.48);

		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.7;
	}

	.header-divider {
		width: 100%;
		height: 1px;

		margin: 3.5rem 0;

		background: rgba(255, 255, 255, 0.1);
	}

	.article-body {
		max-width: 720px;
	}

	.article-body :global(p) {
		margin: 0 0 1.65rem;

		color: rgba(255, 255, 255, 0.72);

		font-size: 1.05rem;
		font-weight: 400;
		line-height: 1.85;
	}

	.article-body :global(p:first-child) {
		font-size: 1.12rem;
		color: rgba(255, 255, 255, 0.84);
	}

	.article-body :global(h2) {
		margin: 3.5rem 0 1.25rem;

		color: rgba(255, 255, 255, 0.95);

		font-size: 1.8rem;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.article-body :global(h3) {
		margin: 2.75rem 0 1rem;

		color: rgba(255, 255, 255, 0.9);

		font-size: 1.35rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.article-body :global(strong) {
		color: rgba(255, 255, 255, 0.92);
		font-weight: 600;
	}

	.article-body :global(em) {
		color: rgba(255, 255, 255, 0.75);
	}

	.article-body :global(a) {
		color: rgba(255, 255, 255, 0.9);

		text-decoration-color: rgba(255, 255, 255, 0.3);
		text-underline-offset: 0.2em;

		transition: text-decoration-color 0.2s ease;
	}

	.article-body :global(a:hover) {
		text-decoration-color: rgba(255, 255, 255, 0.9);
	}

	.article-body :global(ul),
	.article-body :global(ol) {
		margin: 1.5rem 0 2rem;
		padding-left: 1.4rem;
	}

	.article-body :global(li) {
		margin-bottom: 0.7rem;

		color: rgba(255, 255, 255, 0.72);

		font-size: 1.05rem;
		line-height: 1.75;
	}

	.article-body :global(li::marker) {
		color: rgba(255, 255, 255, 0.3);
	}

	.article-body :global(blockquote) {
		margin: 2.5rem 0;
		padding-left: 1.5rem;

		border-left: 1px solid rgba(255, 255, 255, 0.25);
	}

	.article-body :global(blockquote p) {
		color: rgba(255, 255, 255, 0.58);

		font-size: 1.1rem;
		font-style: italic;
	}

	.article-body :global(code) {
		padding: 0.15rem 0.35rem;

		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 5px;

		background: rgba(255, 255, 255, 0.05);

		font-size: 0.9em;
	}

	.article-body :global(pre) {
		margin: 2rem 0;
		padding: 1.25rem;

		overflow-x: auto;

		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 10px;

		background: rgba(255, 255, 255, 0.035);
	}

	.article-body :global(pre code) {
		padding: 0;

		border: 0;

		background: transparent;
	}

	.article-footer {
		max-width: 720px;

		margin-top: 5rem;
	}

	.footer-divider {
		width: 100%;
		height: 1px;

		margin-bottom: 2rem;

		background: rgba(255, 255, 255, 0.1);
	}

	.article-footer a {
		color: rgba(255, 255, 255, 0.45);

		font-size: 0.85rem;
		text-decoration: none;

		transition: color 0.2s ease;
	}

	.article-footer a:hover {
		color: rgba(255, 255, 255, 0.85);
	}

	@media (max-width: 767px) {
		.article-page {
			padding: 3rem 0 4rem;
		}

		.back-link {
			margin-bottom: 2.75rem;
		}

		h1 {
			font-size: 2.6rem;
			line-height: 1.04;
		}

		.article-description {
			margin-top: 1.4rem;
		}

		.header-divider {
			margin: 2.75rem 0;
		}

		.article-body :global(p) {
			font-size: 1rem;
			line-height: 1.8;
		}

		.article-body :global(p:first-child) {
			font-size: 1.05rem;
		}

		.article-body :global(li) {
			font-size: 1rem;
		}

		.article-body :global(h2) {
			margin-top: 3rem;

			font-size: 1.6rem;
		}

		.article-footer {
			margin-top: 4rem;
		}
	}
</style>